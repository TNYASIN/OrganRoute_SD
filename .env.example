# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.

# Which LLM to use: claude (default) | openai | gemini
AI_PROVIDER=claude

# Optional: override the provider's default model
# AI_MODEL=claude-sonnet-5-5

# Only the key for your chosen provider is needed
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
