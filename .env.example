# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.

# Which LLM to use: claude (default) | openai | gemini
AI_PROVIDER=claude

# Optional: override the provider's default model
# AI_MODEL=claude-sonnet-5-5

# Only the key for your chosen provider is needed
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Team alerts via ntfy (free phone push). Install the ntfy app and subscribe to the same topic.
# Pick something hard to guess: anyone who knows the topic can read it.
# NTFY_TOPIC=organroute-change-me-x7k2q9

# Team alerts via Twilio (optional; free trials can't send custom messages). From console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS: your Twilio number. WhatsApp Sandbox: whatsapp:+14155238886
# TWILIO_FROM=
# Comma-separated, +1 format. Trial accounts: verified numbers only
# ALERT_TO=+15551234567,+15557654321
